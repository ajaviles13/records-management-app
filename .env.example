# Egnyte File Share connector credentials (local-first placeholder).
#
# These are read and written by the Configure > Connectors page and stored in a
# gitignored .env at the repo root purely so the UI has something real to persist
# to during local development. Nothing in this codebase reads these values yet.
#
# Production migration path: move these into AWS Systems Manager Parameter Store
# (as SecureString parameters) and read them directly from backend Lambdas. Once
# that lands, the secret should never be stored in a repo file or served to the
# browser again.
EGNYTE_CLIENT_ID=
EGNYTE_CLIENT_SECRET=
